DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

POSTGRES_DB=orfwear
POSTGRES_USER=orfwear
POSTGRES_PASSWORD=change-me-local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/0

# Absolute origins used to build the payment return leg.
PAYMENTS_CALLBACK_BASE_URL=http://localhost:8001
STOREFRONT_BASE_URL=http://localhost:3000

# Payments — local sandbox by default; production refuses to boot on it.
PAYMENT_PROVIDER=apps.payments.providers.local.LocalSandboxProvider
PAYMENTS_ALLOW_SANDBOX=true
# PAYMENT_PROVIDER=apps.payments.providers.zarinpal.ZarinPalProvider
# ZARINPAL_MERCHANT_ID=
# ZARINPAL_BASE_URL=https://sandbox.zarinpal.com

# OTP delivery — LocalSmsBackend only logs; the code comes back in the response.
SMS_BACKEND=apps.users.sms.LocalSmsBackend
OTP_EXPOSE_DEBUG_CODE=true
# SMS_BACKEND=apps.users.sms.kavenegar.KavenegarSmsBackend
# KAVENEGAR_API_KEY=
# KAVENEGAR_OTP_TEMPLATE=
# KAVENEGAR_SENDER=

# Optional: fall back to sqlite for first boot without Docker
# DATABASE_URL=sqlite:///db.sqlite3
