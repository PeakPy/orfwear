# Root orchestration only. Each app also has its own .env.example.
# Copy to .env for docker compose variable substitution.

COMPOSE_PROJECT_NAME=orfwear

# Public URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Postgres
POSTGRES_DB=orfwear
POSTGRES_USER=orfwear
POSTGRES_PASSWORD=change-me-local
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Next.js
NODE_ENV=development
